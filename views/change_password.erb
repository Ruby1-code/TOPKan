<header class="topbar">
  <a class="brand" href="/directory" aria-label="TOPKan directory"><span class="brand-mark">T</span><span>TOPKan</span></a>
  <div class="user-menu"><a class="account-link" href="/account/passkeys">Passkeys</a><a class="account-link" href="/directory">← Back to directory</a><form action="/logout" method="post"><button class="logout-button" type="submit">Sign out <span>↗</span></button></form></div>
</header>

<main class="login-shell">
  <section class="login-card password-card">
    <div class="login-emblem"><span class="brand-mark">T</span></div>
    <div class="eyebrow login-eyebrow"><span class="eyebrow-dot"></span> ACCOUNT SECURITY</div>
    <h1>Change password</h1>
    <p class="login-subtitle">Choose a new password for your TOPKan account.</p>

    <% if @flash %><div class="flash <%= h(@flash[:type]) %>" role="status"><span class="flash-icon"><%= @flash[:type] == "error" ? "!" : "✓" %></span><%= h(@flash[:message]) %></div><% end %>

    <form action="/account/password" method="post" class="login-form">
      <label>Current password<input type="password" name="current_password" autocomplete="current-password" required autofocus></label>
      <label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="8" required></label>
      <label>Confirm new password<input type="password" name="password_confirmation" autocomplete="new-password" minlength="8" required></label>
      <button class="button button-primary login-submit" type="submit">Update password <span>→</span></button>
    </form>
    <div class="login-secure"><span class="lock-icon">▣</span> Passwords are stored as secure bcrypt hashes.</div>
  </section>
  <footer class="login-footer"><span>TOPKan <span class="footer-divider">/</span> Account security</span><span>Made for keeping things connected <span class="footer-heart">♥</span></span></footer>
</main>
